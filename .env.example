# PariView Root Environment Configuration Template
# Copy this file to .env and provide your deployment-specific credentials

ENVIRONMENT=development
DEBUG=True

# Application Security
# In production, must be at least 32 characters of high-entropy cryptographic randomness
SECRET_KEY=generate_a_cryptographically_secure_32_char_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary PostgreSQL Connection String
DATABASE_URL=postgresql://pariview_user:your_secure_db_password@localhost:5432/pariview

# Alternative PostgreSQL parameter breakdown (Local Dev / Docker)
POSTGRES_SERVER=localhost
POSTGRES_USER=pariview_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=pariview
POSTGRES_PORT=5432

# Redis Cache URL
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI Integration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
